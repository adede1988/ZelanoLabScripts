function [] =   crossChannelLinkPipeline(targFile, subFiles, datPre, subID, taskID)


x = 5; 

datFolder = [datPre 'CHANDAT']; 
chanFiles = dir(datFolder);
test = cellfun(@(x) length(x)>0, strfind({chanFiles.name}, '.mat'));
chanFiles = chanFiles(test); 

test = cellfun(@(x) length(x)>0, strfind({chanFiles.name}, '_macro'));
groupFiles = chanFiles(test); 
test = cellfun(@(x) length(x)>0, strfind({groupFiles.name}, subID));
groupFiles = groupFiles(test); 
test = cellfun(@(x) length(x)>0, strfind({groupFiles.name}, taskID));
groupFiles = groupFiles(test); 


folderName = subFiles(1).folder; 
pathStem = strsplit(folderName, 'CHANDAT'); 
pathStem = pathStem{1};

%% bring in the best macro channel for this participant: 

disp('bringing in the macro channel')

epochNames = ["inhale rise","inhale fall","exhale rise","exhale fall","pause"];
gammaBandHz     = [25 60];
baselineBandHz  = [10 200];
excludeHzAroundPeak = 5;



chanSumm = struct([]);  % <-- NOT repmat(struct(),...)
cci = 1; 
for ci = 1:numel(groupFiles)
    fpath = fullfile(pathStem, 'CHANDAT_processed/', groupFiles(ci).name); 
    if exist(fpath, 'file')
    S = load(fpath, "chanDat");
    macChan = S.chanDat;

    s = summarize_channel_gamma(macChan, epochNames, ...
        gammaBandHz, baselineBandHz, excludeHzAroundPeak);

    s.filePath = string(fpath);
    s.fileName = string(groupFiles(ci).name);

    if cci == 1
        chanSumm = repmat(s, numel(groupFiles), 1);  % template has all fields
    end

    chanSumm(cci) = s;
    cci = cci + 1; 
    end
end

% Pick winner (robust z-scored composite within this group)
[winnerIdx, scoreTable, chanSumm] = pick_winner_channel(chanSumm);

winner = chanSumm(winnerIdx);
fprintf("Winner: %s  (score=%.3f)\n", winner.chanLabelSafe, winner.score);
sessNum = winner.sessNum;
taskName = taskID;
prefix = sprintf("%s_sess%d_%s_%s", winner.subIDSafe, sessNum, winner.chanLabelSafe, taskName);


Sw = load(winner.filePath, "chanDat");
macChan = Sw.chanDat;

chanDat = load(fullfile([targFile.folder '_processed'], targFile.name)); 
chanDat = chanDat.chanDat; 

%% construct small file summary 
outSum = struct; 
outSum.task      = chanDat.task; 
outSum.sessID    = chanDat.sessID; 
outSum.sessNum   = chanDat.sessNum; 
outSum.type      = chanDat.type; 
outSum.fs        = chanDat.fs; 
outSum.label     = chanDat.labels{chanDat.chi};
outSum.fn        = targFile.name;
outSum.chi       = chanDat.chi; 
outSum.rawN      = size(chanDat.behDat,1);

%% find outlier breaths: 

outlierSum = sum(chanDat.tf.powZ>=50, [2,3]); 
chanDat.use(outlierSum>1000) = 0; 
useVec = chanDat.use == 1; 
outSum.numOutlier= sum(outlierSum>1000); 
outSum.usable    = sum(useVec); 



%% Summarize HRV

HRV_RMS  = chanDat.behDat.HRV_RMSSD30(useVec);
HRV_SDNN = chanDat.behDat.HRV_SDNN30(useVec);
HRV_RSA  = chanDat.behDat.HRV_RSAamp(useVec); 
HRV_mm   = chanDat.behDat.RR_max_min(useVec); 
HR       = chanDat.behDat.HR_mean(useVec); 

HRVsum = struct; 
hrvVarNames = {'HRV_RMSSD30','HRV_SDNN30','HRV_RSAamp','RR_max_min', 'HR'};
hrvVals     = {HRV_RMS,       HRV_SDNN,     HRV_RSA,     HRV_mm,     HR};

statNames = {'mean','median','mode','min','max','sd','iqr','n'};

for iV = 1:numel(hrvVarNames)
    S = local_calcStats(hrvVals{iV});   % finite-only inside helper
    base = [hrvVarNames{iV} '_'];               % e.g., 'HRV_RMSSD30_'

    HRVsum.([base 'mean'])   = S.mean;
    HRVsum.([base 'median']) = S.median;
    HRVsum.([base 'mode'])   = S.mode;
    HRVsum.([base 'min'])    = S.min;
    HRVsum.([base 'max'])    = S.max;
    HRVsum.([base 'sd'])     = S.sd;
    HRVsum.([base 'iqr'])    = S.iqr;
end


taskVec = string(chanDat.behDat.task(useVec));
conds   = ["audio","focus","shadow"];
task = string(taskVec);
for ii = 1:numel(conds)
    idx = task == conds(ii);
    if sum(idx)>5
    for iV = 1:numel(hrvVarNames)
        S = local_calcStats(hrvVals{iV}(idx));   % finite-only inside helper
        base = [hrvVarNames{iV} '_' conds{ii} '_'];               % e.g., 'HRV_RMSSD30_'
    
        HRVsum.([base 'mean'])   = S.mean;
        HRVsum.([base 'median']) = S.median;
        HRVsum.([base 'mode'])   = S.mode;
        HRVsum.([base 'min'])    = S.min;
        HRVsum.([base 'max'])    = S.max;
        HRVsum.([base 'sd'])     = S.sd;
        HRVsum.([base 'iqr'])    = S.iqr;
    end
    end
end
outSum.hrv = HRVsum; 


% --- robust min-max scaling to [0,1] (handles NaNs / constants) ---
minmax01 = @(v) local_minmax01(v);
rms01  = minmax01(HRV_RMS);
sdnn01 = minmax01(HRV_SDNN);
rsa01  = minmax01(HRV_RSA);

% --- overall state = mean of the 3 scaled measures ---
overall = mean([rms01 sdnn01 rsa01], 2, 'omitnan');


HRVidx = overall > median(overall); 



%% get band power and ITPC values 


powZ       = chanDat.tf.powZ(useVec,:,:); 
phase      = chanDat.tf.phase(useVec,:,:); 
frex       = chanDat.tf.frex; 
freqBreaks = [2, 8; ...
              8, 14; ...
              14,30];
freqLabs = {'theta','alpha','beta'};


%% ===== Band max power + band max ITPC by HRV group, plus BOOTSTRAP + shuffles =====
% Now: observed outputs are MEANS across nBoot bootstraps (resampling breaths
% within each HRV group with replacement).
%
% Outputs:
%   powBandMax, itpcBandMax : [nBand x 3 x nTime]  (low, high, diff=high-low)
%   powShuf, itpcShuf       : [nShuf x nBand x 3 x nTime]

nShuf = 1000;
nBoot = 1;

% --- make frex a row ---
frex = frex(:)';

% --- band frequency indices (non-overlapping at boundaries) ---
nBand = size(freqBreaks,1);
bandFi = cell(nBand,1);
for b = 1:nBand
    lo = freqBreaks(b,1);
    hi = freqBreaks(b,2);
    if b < nBand
        bandFi{b} = find(frex >= lo & frex <  hi);
    else
        bandFi{b} = find(frex >= lo & frex <= hi);
    end
    if isempty(bandFi{b})
        warning('No freqs found for band %d (%.2f–%.2f Hz).', b, lo, hi);
    end
end

nTime = size(powZ,2);

%% ---------------- BOOTSTRAPPED OBSERVED (within-group resample) ----------------
powBoot  = nan(nBoot, nBand, 3, nTime);
itpcBoot = nan(nBoot, nBand, 3, nTime);

idxLow  = find(HRVidx==0);
idxHigh = find(HRVidx==1);

if isempty(idxLow) || isempty(idxHigh)
    warning('One HRV group is empty: low n=%d, high n=%d. Bootstraps may be NaN.', numel(idxLow), numel(idxHigh));
end

for b = 1:nBoot
    % resample within each group (with replacement), preserving group sizes
    if nBoot > 1
        lowS  = idxLow(  randi(numel(idxLow),  [numel(idxLow)  1]) );
        highS = idxHigh( randi(numel(idxHigh), [numel(idxHigh) 1]) );
    else
        lowS  = idxLow;
        highS = idxHigh;
    end


    bootIdx = [lowS; highS];

    % make a corresponding HRV label vector for the boot sample
    HRV_boot = [zeros(numel(lowS),1); ones(numel(highS),1)];

    [pTmp, iTmp] = local_bandMax_pow_itpc(powZ(bootIdx,:,:), phase(bootIdx,:,:), bandFi, HRV_boot);
    powBoot(b,:,:,:)  = pTmp;
    itpcBoot(b,:,:,:) = iTmp;
end

% observed = mean across bootstraps
powBandMax  = squeeze(mean(powBoot,  1, 'omitnan'));   % [nBand x 3 x nTime]
itpcBandMax = squeeze(mean(itpcBoot, 1, 'omitnan'));   % [nBand x 3 x nTime]

%% ---------------- SHUFFLES (permute labels; no resampling) ----------------
powShuf  = nan(nShuf, nBand, 3, nTime);
itpcShuf = nan(nShuf, nBand, 3, nTime);

for s = 1:nShuf
    HRV_sh = HRVidx(randperm(numel(HRVidx)));
    [pTmp, iTmp] = local_bandMax_pow_itpc(powZ, phase, bandFi, HRV_sh);
    powShuf(s,:,:,:)  = pTmp;
    itpcShuf(s,:,:,:) = iTmp;
end



outSum.powBandMax = powBandMax; 
outSum.itpcBandMax = itpcBandMax; 
outSum.powShuf = powShuf; 
outSum.itpcShuf = itpcShuf; 
outSum.frexBands = freqBreaks; 
outSum.bandLabs = freqLabs;  




rawChanDat = load(fullfile(targFile.folder, targFile.name)); 
rawChanDat = rawChanDat.chanDat; 

bpFilt = designfilt('bandpassiir', ...
                'FilterOrder', 8, ...
                'HalfPowerFrequency1', 2, ...
                'HalfPowerFrequency2', 10, ...
                'SampleRate', rawChanDat.fs, ...
                'DesignMethod', 'butter');

thetaDat = filtfilt(bpFilt, rawChanDat.data);


%% R - OB link 

outSum.gamEnv = macChan.gammaEnv.gamEnv; 
outSum.flatSpec= macChan.fooof.spectra_flat_log10; 
out

tm = chanDat.tf.frex>=4 & chanDat.tf.frex<=10; 

behDat = chanDat.behDat;
behDat.gamPeak = macChan.gammaBurst.peak; 
behDat.gamFreq = macChan.gammaEnv.gamFreq; 
behDat.gamBackground = median(outSum.gamEnv, 2, 'omitnan'); 
[~, idx] = max(outSum.gamEnv, [], 2); 
behDat.gamPeakidx50 = idx; 
idx = 1:length(behDat.gamPeakidx50); 
behDat.gamPeakidxFull = arrayfun(@(x,y) macChan.behDat.finalOnset(x) +...
                                            1000 +...
                                            macChan.targIDX(x,y), ...
                                            idx(:), ...
                                            behDat.gamPeakidx50(:)); 


%find the pac informed peak in the template index: 
PACgamPeak = macChan.pac_peaks.peakIDX_local; 
PACgamPeakOffset = macChan.targIDX - PACgamPeak;
[~, PACgamPeakidx50] = min(abs(PACgamPeakOffset), [], 2); 
behDat.PACgamPeakidx50 = PACgamPeakidx50; 
idx = 1:length(PACgamPeakidx50); 
behDat.PACgamPeakidxFull = arrayfun(@(x,y) macChan.behDat.finalOnset(x) +...
                                            1000 +...
                                            macChan.targIDX(x,y), ...
                                            idx(:), ...
                                            PACgamPeakidx50(:)); 

%GET ERPs locked to the PAC informed peaks and to the full time informed
%PEAKS: 
win = -2000:2000; 

ERPtmpidx = behDat.PACgamPeakidxFull + win; 
ERPtmpidx(ERPtmpidx<1) = 1; 
ERPtmpidx(ERPtmpidx>length(thetaDat)) = length(thetaDat); 
goodidx = ~isnan(ERPtmpidx(:,1)); 
ERPtmp = nan(size(ERPtmpidx)); 
ERPtmp(goodidx, :) = thetaDat(ERPtmpidx(goodidx,:)); 

outSum.ERP_pacPeak = ERPtmp; 

win = -2000:2000; 

ERPtmpidx = behDat.gamPeakidxFull + win; 
ERPtmpidx(ERPtmpidx<1) = 1; 
ERPtmpidx(ERPtmpidx>length(thetaDat)) = length(thetaDat); 
goodidx = ~isnan(ERPtmpidx(:,1)); 
ERPtmp = nan(size(ERPtmpidx)); 
ERPtmp(goodidx, :) = thetaDat(ERPtmpidx(goodidx,:)); 

outSum.ERP_allPeak = ERPtmp; 


behDat.gamRspPACphase = macChan.pac.diag.fb_phase;

N  = 50;
i0 = 11;
step = 2*pi/N;

k = round(behDat.gamRspPACphase / step);              % nearest template
idx = mod((i0-1) + k, N) + 1;   
behDat.gamRspPACphase_idx50 = idx; 


behDat.gamRspPACLock  = macChan.pac.diag.pac.z.fbRankPct; 
behDat.gamRspPACStrength = macChan.pac.diag.fb_pacZ; 
%median over time, median over frequency to get theta band power: 
behDat.(['thetaPow_1_' outSum.label]) = median(median(chanDat.tf.powZ(:,1:10,tm), [2] , 'omitnan'), 3); 
behDat.(['thetaPow_2_' outSum.label]) = median(median(chanDat.tf.powZ(:,11:20,tm), [2] , 'omitnan'), 3); 
behDat.(['thetaPow_3_' outSum.label]) = median(median(chanDat.tf.powZ(:,21:30,tm), [2] , 'omitnan'), 3); 
behDat.(['thetaPow_4_' outSum.label]) = median(median(chanDat.tf.powZ(:,31:40,tm), [2] , 'omitnan'), 3); 
behDat.(['thetaPow_5_' outSum.label]) = median(median(chanDat.tf.powZ(:,41:50,tm), [2] , 'omitnan'), 3); 



%% === Breath-wise ISPC between macChan and chanDat (4–10 Hz) ===
% Assumes:
%   macChan.trial.data : [nBreath x 6000]
%   chanDat.trial.data : [nBreath x 6000]
% You must set fs (Hz) correctly.

fs = chanDat.fs;   % <-- set this (or whatever your sampling rate variable is)

x1 = double(macChan.trial.data);   % [breath x time]
x2 = double(chanDat.trial.data);

%hacky patch: 
if sum(isnan(x2), 'all') > 0
    badidx = find(sum(isnan(x1), [2])>0);
    goodidx = find(sum(isnan(x1), [2])==0);
    x1(badidx, :) = x1(goodidx(1:length(badidx)), :);
    x2(badidx, :) = x2(goodidx(1:length(badidx)), :); 
end

% --- IIR Butterworth bandpass (4–10 Hz), zero-phase ---
ord = 4;
[b,a] = butter(ord, [4 10]/(fs/2), 'bandpass');




x1f = filtfilt(b,a, x1.').';   % filter along time
x2f = filtfilt(b,a, x2.').';

% --- analytic phase via Hilbert ---
phi1 = angle(hilbert(x1f.')).';   % [breath x time]
phi2 = angle(hilbert(x2f.')).';

% --- phase difference wrapped to [-pi, pi] ---
dphi = atan2(sin(phi1 - phi2), cos(phi1 - phi2));  % [breath x time]

% --- ISPC strength and mean phase difference per breath ---
mvec     = mean(exp(1i*dphi), 2);   % mean across timepoints (6000) per breath
ISPC     = abs(mvec);               % [breath x 1]
meanPhi  = angle(mvec);             % [breath x 1]  (radians)


behDat.(['theta_theta_ISPC' outSum.label]) = ISPC; 
behDat.(['theta_theta_phase' outSum.label]) = meanPhi; 



outSum.behDat = behDat; 












 fpath = fullfile(pathStem, 'CHANDAT_processed/', 'scalpPow_itpc');
 if ~isdir(fpath)
     mkdir(fpath)
 end

save(fullfile(fpath, [outSum.sessID '_' outSum.task '_' outSum.label  '.mat'] ), 'outSum', '-v7.3'); 









end





% ---------- local helper (paste at end of file/function) ----------
function S = local_calcStats(x)
    x = x(:);
    x = x(isfinite(x));   % drops NaN/Inf

    S = struct('mean',NaN,'median',NaN,'mode',NaN,'min',NaN,'max',NaN,'sd',NaN,'iqr',NaN,'n',0);

    S.n = numel(x);
    if S.n == 0, return; end

    S.mean   = mean(x);
    S.median = median(x);
    S.min    = min(x);
    S.max    = max(x);

    if S.n >= 2
        S.sd = std(x,0);  % sample SD (N-1)
    end

    % IQR (robust to outliers)
    S.iqr = iqr(x);

    % Mode: for very continuous data, use a histogram-mode approximation;
    % otherwise use MATLAB's exact mode.
    if S.n >= 5 && numel(unique(x)) > max(10, round(0.5*S.n))
        bw = 2*S.iqr/(S.n^(1/3));  % Freedman–Diaconis
        if isfinite(bw) && bw > 0
            edges = min(x):bw:max(x);
            if numel(edges) >= 2
                c = histcounts(x, edges);
                [~,ii] = max(c);
                S.mode = mean(edges(ii:ii+1)); % bin center
                return
            end
        end
    end
    S.mode = mode(x);
end


function y = local_minmax01(v)
    v = v(:);
    mn = min(v(isfinite(v)));
    mx = max(v(isfinite(v)));
    if isempty(mn) || isempty(mx) || mx <= mn
        y = nan(size(v));
        if any(isfinite(v)), y(isfinite(v)) = 0; end
        return
    end
    y = (v - mn) ./ (mx - mn);
end


function [powBandMax, itpcBandMax] = local_bandMax_pow_itpc(powZ, phase, bandFi, HRVidx)
    % HRVidx: 0=low, 1=high
    nBand = numel(bandFi);
    nTime = size(powZ,2);

    powBandMax  = nan(nBand,3,nTime);  % low, high, diff
    itpcBandMax = nan(nBand,3,nTime);

    for g = 1:2
        if g == 1
            m = (HRVidx==0);
        else
            m = (HRVidx==1);
        end
        if ~any(m), continue; end

        meanPow = squeeze(mean(powZ(m,:,:), 1, 'omitnan'));                 % [nTime x nFreq]
        itpcTF  = squeeze(abs(mean(exp(1i*phase(m,:,:)), 1, 'omitnan')));   % [nTime x nFreq]

        for b = 1:nBand
            fi = bandFi{b};
            if isempty(fi), continue; end
            powBandMax(b,g,:)  = max(meanPow(:,fi), [], 2, 'omitnan');
            itpcBandMax(b,g,:) = max(itpcTF(:,fi),  [], 2, 'omitnan');
        end
    end

    % diff = high - low
    powBandMax(:,3,:)  = powBandMax(:,2,:)  - powBandMax(:,1,:);
    itpcBandMax(:,3,:) = itpcBandMax(:,2,:) - itpcBandMax(:,1,:);
end