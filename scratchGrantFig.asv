
%% echem
%% 
% datadir = '/Volumes/neurology/Zelano_Lab/Lab_Collaboration/VT Collaboration_Echem Datasets/20250225_NWM_250225_OBE_NWU_AS'; 
datadir = 'R:\Neurology\Zelano_Lab\Lab_Common/EChem/AAAA_NWM/20251124_NWM_251006_OBE_NWU_RY_1'; 
predictdir = fullfile(datadir, 'predictions/2025-01-18__MMA_NW019_47bW03R06__request_002/ensemble_prediction/');

addpath('R:\Neurology\Zelano_Lab\Lab_Common\EChem\AAAA_NWM')
addpath('G:\My Drive\GitHub\ZelanoLabScripts')
addpath('G:\My Drive\GitHub\slowBreathing')
