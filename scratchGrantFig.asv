%% load data 
%%%% 0005 for focused breathing 
data = readtable(fullfile(predictdir, '20251124_NWM_251006_OBE_NWU_RY_1_0005_prediction.csv')); 
datalabel = {'DA', '5HT', 'pH', 'NE', 'H2O2'}; 

%% 
datats = [data.NE'; data.DA'; data.x5HT'];

%% 
rawdatafilename = '20251124_NWM_251006_OBE_NWU_RY_1_0005.abf'; 
%% 
[d, si] = abfload(fullfile(datadir, rawdatafilename));

%%% 
datads = []; 
fs = 10000; 
fsds = 1000; 

for chnlidx = 1:6
    chnl = squeeze(d(:, chnlidx, :));
    chnl = reshape(chnl, [1, numel(chnl)]);
    chnlds = downsample(chnl, 100); 
    datads(:, chnlidx) = chnlds;
end 


%% breathing signal 
resp = datads(:, 5)';
resp = -resp; 
resp = resp-mean(resp); 
% x = [0:1/1000:(length(resp)-1)/1000]; % x in seconds 

% resp_filt = ft_preproc_lowpassfilter(resp, fsds, 50, [], 'fir');
%% NEW preproc 

raw_signal = datads(:, 1);
pk = []; 
for i = 1: length(raw_signal)/100
    pk(i) = max(raw_signal((i-1)*100+1:i*100));  

end 
datatsz = zscore(datats, 0, 2); 
pkz = zscore(pk); 
[data_clean, metric] = echem_preproc_new(datatsz, pkz, 10); 

datats_clean = [data_clean.ch(1).sub_bsl_lp, data_clean.ch(2).sub_bsl_lp,data_clean.ch(3).sub_bsl_lp]; 
datats_clean = datats_clean'; 

datats_spr = datats_clean; 
% 0 padding 
padlength = 20; 
datats_pad = [fliplr(datats_spr(:, 1:padlength)), datats_spr, fliplr(datats_spr(:, end-padlength+1:end))]; 
t_orig = (0:size(datats_pad, 2)-1)/10; 
datats_pad_1khz = []; 
for didx = 1:3 
    datats_pad_1khz(didx, :) = resample(datats_pad(didx, :), t_orig, 1000); 
end 
padup = round(padlength*1000/10); 
datats_1khz = datats_pad_1khz(:, padup+1:end-padup); 


datats_1khz_sm_d = datats_1khz; 

norepinephrine = datats_1khz_sm_d(1, :); 
dopamine = datats_1khz_sm_d(2, :); 
serotonin = datats_1khz_sm_d(3, :); 
resp = resp; 

%% resample norepinephrine, dopamine, serotonin, and resp to 2000 Hz

fs_in  = 1000;
fs_out = 2000;
[p,q]  = rat(fs_out/fs_in);   % for 2000/1000 -> p=2, q=1

% Convert to columns for resample(), and force equal length (keep aligned)
NE = norepinephrine(:);
DA = dopamine(:);
SE = serotonin(:);
RP = resp(:);

L = min([numel(NE), numel(DA), numel(SE), numel(RP)]);
NE = NE(1:L);  DA = DA(1:L);  SE = SE(1:L);  RP = RP(1:L);

NE_2k = resample(NE, p, q);
DA_2k = resample(DA, p, q);
SE_2k = resample(SE, p, q);
RP_2k = resample(RP, p, q);

% Back to row vectors (to match your datats_1khz_sm_d(?, :) convention)
norepinephrine = NE_2k.';
dopamine       = DA_2k.';
serotonin      = SE_2k.';
respEchem           = RP_2k.';


%% ephys



curDat = load('R:\Neurology\Zelano_Lab\Lab_Common\OBEControl\251006_OBE_NWU_RY_1\raw\raw_focusedBreathing_echem\raw_focusedBreathing_echem.mat');
curDat = curDat.curDat; 

data = curDat.rawData.trial{1};


outDat = struct; 
outDat.data = data;
outDat.labels = curDat.outLabs; 
outDat.fs = 2000; 
outDat.figs = 'R:\Neurology\Zelano_Lab\Lab_Common\Adam\Dupi_processing\251006_OBE_NWU_RY_1';
outDat.sessID =  '251006_OBE_NWU_RY_1';
P = struct; 
P.macroRemove = [];
P.spikeClean = false; 
P.spikeWin = 44; 
P.rspIDX = 1; 
P.rspFlip = 1; 
outDat.rspIDX = P.rspIDX;
outDat.rspFlip = P.rspFlip; 
outDat = preprocess_macros(outDat,P); 
outDat = process_respiration_breathing(outDat, P); 



  idx = cellfun(@(x) contains(x, 'rsp'), outDat.labels);
    rspDat = outDat.data(idx,:); 
    rspDat = rspDat(P.rspIDX,:);
    rspDat = rspDat .* P.rspFlip;
    figure; plot(rspDat)


%% find time alignment offset
% ephys respiration is in a vector called rspDat
% echem respiration is in a vector called respEchem
% all signals are at 2000 Hz

fs = 2000;

% force column vectors
x = rspDat(:);        % ephys
y = respEchem(:);     % echem

% --- preprocess to make peak finding robust despite dynamic range differences ---
% (respiration is low-frequency; lowpass removes high-freq junk that can confuse peak detection)
fc = 3; % Hz (adjust if needed)
[b,a] = butter(4, fc/(fs/2), 'low');

xF = filtfilt(b,a,double(x));
yF = filtfilt(b,a,double(y));

xZ = (xF - mean(xF,'omitnan')) ./ std(xF,[],'omitnan');
yZ = (yF - mean(yF,'omitnan')) ./ std(yF,[],'omitnan');

% --- detect inhalation peaks (positive peaks) on both ---
minPeakDist_s = 0.25;                        % seconds (adjust; prevents double-counting)
minPeakDist   = round(minPeakDist_s * fs);
minProm       = 0.5;                         % in z-units; relax if too few peaks

[~,locX] = findpeaks(xZ, 'MinPeakDistance', minPeakDist, 'MinPeakProminence', minProm);
[~,locY] = findpeaks(yZ, 'MinPeakDistance', minPeakDist, 'MinPeakProminence', minProm);

% If peak detection was too strict, relax a bit
if numel(locX) < 5 || numel(locY) < 5
    [~,locX] = findpeaks(xZ, 'MinPeakDistance', minPeakDist, 'MinPeakProminence', 0.2);
    [~,locY] = findpeaks(yZ, 'MinPeakDistance', minPeakDist, 'MinPeakProminence', 0.2);
end

% Use the first K peaks to estimate a *single* constant lag (good if clocks are stable)
K = min([numel(locX), numel(locY), 200]);
locX = locX(1:K);
locY = locY(1:K);

% For each EChem peak, find nearest ephys peak and take the median difference (robust to a few mismatches)
lagCand = zeros(K,1);
for i = 1:K
    [~,idx] = min(abs(locX - locY(i)));
    lagCand(i) = locX(idx) - locY(i);   % + means EChem leads (needs to be delayed)
end

% Drop outliers (bad peak matches), then take median
keep = ~isoutlier(lagCand, 'median');
lagSamples = round(median(lagCand(keep)));     % shift to apply to EChem to align to ephys
lagSec     = lagSamples / fs;

fprintf('Estimated EChem->ephys lag: %d samples (%.3f s)\n', lagSamples, lagSec);

% --- build aligned EChem respiration vector with same length as ephys ---
lenX = numel(x);
lenY = numel(y);

alignedEchemResp = zeros(lenX,1,'like',respEchem);
alignedNE        = zeros(lenX,1,'like',norepinephrine);
alignedDA         = zeros(lenX,1,'like',dopamine);
alignedSA        = zeros(lenX,1,'like',serotonin);



if lagSamples >= 0
    % EChem starts earlier -> delay EChem by padding at the front
    srcStart = 1;
    dstStart = 1 + lagSamples;
else
    % EChem starts later -> advance EChem by dropping initial samples
    srcStart = 1 - lagSamples;
    dstStart = 1;
end

nCopy = min(lenY - srcStart + 1, lenX - dstStart + 1);
if nCopy > 0
    alignedEchemResp(dstStart:dstStart+nCopy-1) = respEchem(srcStart:srcStart+nCopy-1);
    alignedNE(dstStart:dstStart+nCopy-1) = norepinephrine(srcStart:srcStart+nCopy-1);
    alignedDA(dstStart:dstStart+nCopy-1) = dopamine(srcStart:srcStart+nCopy-1);
    alignedSA(dstStart:dstStart+nCopy-1) = serotonin(srcStart:srcStart+nCopy-1);
end

% match your outDat.data row-vector convention
alignedEchemResp = alignedEchemResp.';



% store in outDat
outDat.data(end+1, :) = alignedEchemResp;
outDat.labels{end+1} = 'eChemResp';
outDat.data(end+1, :) = alignedNE; 
outDat.labels{end+1} = 'norepinephrine'; 
outDat.data(end+1, :) = alignedDA; 
outDat.labels{end+1} = 'dopamine'; 
outDat.data(end+1, :) = alignedSA; 
outDat.labels{end+1} = 'serotonin'; 




%% organize data into breath wise trials

bmObj = outDat.bmObj; 
 outDat.behDat = table();

    % Build time axis in seconds for index conversion
    tim = (1:size(outDat.data, 2)) / outDat.fs;

    % Column 2: onset time → sniffOnset and finalOnset (sample indices)
    idx = arrayfun(@(x) find(x <= tim, 1), bmObj(:, 2));
    outDat.behDat.sniffOnset = idx;
    outDat.behDat.finalOnset = idx;

    % Column 12: condition
    outDat.behDat.condition = bmObj(:, 12);

    % Column 1: onset Y value
    outDat.behDat.Yonset = bmObj(:, 1);

    % Column 3: peak Y value
    outDat.behDat.inhaleMax = bmObj(:, 3);

    % Column 4: peak time → inMaxTim (sample indices)
    idx = arrayfun(@(x) find(x <= tim, 1), bmObj(:, 4));
    outDat.behDat.inMaxTim = idx;

    % Column 5: end Y value
    outDat.behDat.Yend = bmObj(:, 5);

    % Column 6: end time → endTim (sample indices)
    idx = arrayfun(@(x) find(x <= tim, 1), bmObj(:, 6));
    outDat.behDat.endTim = idx;

    % Column 7: length (end - onset)
    outDat.behDat.length = bmObj(:, 7);

    % Column 8: amp (peak Y - avg of two ends)
    outDat.behDat.amp = bmObj(:, 8);

    % Column 10: exhale peak Y value
    outDat.behDat.exhaleMin = bmObj(:, 10);

    % Column 11: exhale peak time → exMinTim (sample indices)
    idx = arrayfun(@(x) find(x <= tim, 1), bmObj(:, 11));
    outDat.behDat.exMinTim = idx;

    % Column 14: index
    outDat.behDat.index = bmObj(:, 14);

     R = preprocess_respiration_wholetrace(outDat);
    plot_sniff_epochs(outDat, R);

%% create high frequency componenet for spike detection

  splitFreq = 2;          % Hz cutoff between "low" and "high" components
    hpOrder   = 4;           % 4th-order Butterworth for high-pass
    
    % Design high-pass for the spike-y part (> splitFreq)
    [b_hp, a_hp] = butter(hpOrder, splitFreq/(outDat.fs/2), 'high');
    
    % High-frequency component of the IC
    x_high = filtfilt(b_hp, a_hp, outDat.data(42:46,:).').';   % column


    %% get rid of breaths where neuromodulator signal is erratic/still settling down

    outDat.behDat(outDat.behDat.sniffOnset<150000, :) = []; 
    outDat.behDat(outDat.behDat.sniffOnset>500000, :) = []; 



    %% create snip data 
    targChan = 46; 

    neuromodChans = [53:55]; 
    %trials X time
    powEst = zeros(length(outDat.behDat.sniffOnset), 3501, 20); 
    frex = linspace(30,100,20); 
    bandWidth = logspace(log10(5), log10(20), 20);
    
    %storage of neuromodulators 
    neuroModOut = zeros(length(outDat.behDat.sniffOnset), 3501, 3); 

    %store resp copy
    idx = cellfun(@(x) contains(x, 'rsp'), outDat.labels);
    rspDat = outDat.data(idx,:); 
    rspDat = rspDat(P.rspIDX,:);
    rspDat = rspDat .* P.rspFlip;
    respOut = zeros(length(outDat.behDat.sniffOnset), 3501); 
    storedFilters = struct; 

for f = 1:length(frex)
    storedFilters(f).low = designfilt('highpassiir','FilterOrder',4, ...
            'HalfPowerFrequency',frex(f)-bandWidth(f),'SampleRate',2000);
    storedFilters(f).high = designfilt('lowpassiir','FilterOrder',4, ...
            'HalfPowerFrequency',frex(f)+bandWidth(f),'SampleRate',2000); 
end

starti = []; 
endi = []; 

 for ii = 1:length(outDat.behDat.sniffOnset)
      
    disp(ii)

    
    
    mask = outDat.behDat.sniffOnset(ii)-1000 : outDat.behDat.sniffOnset(ii)+2500;
    fs   = outDat.fs;
    
    X = outDat.data(targChan, mask);   % 1 x T
    T = length(X);
    
    % --- detect artifacts using channel targChan ---
    x_det = X(:);               % (column)
    N = numel(x_det);
    
    pad_ms = 20;
    pad = round(pad_ms/1000 * fs);
    
    thr   = 200;                    % set for your units
    above = x_det > thr;            % (use abs(x_det) > thr if polarity can flip)
    
    d = diff([false; above; false]);
    seg_starts = find(d == 1);
    seg_ends   = find(d == -1) - 1;
    
    stim_idx = zeros(numel(seg_starts),1);
    for k = 1:numel(seg_starts)
        s = seg_starts(k);
        e = seg_ends(k);
        [~, rel] = max(abs(x_det(s:e)));
        stim_idx(k) = s + rel - 1;
    end
    
    %make snips: 
    snips = zeros(numel(stim_idx)-1, 140); 
    for k = 1:numel(stim_idx)-1
        snipMask = stim_idx(k)+50:stim_idx(k+1)-11;
        if length(snipMask)>140
            snipMask = snipMask(1:140);
        end
        if length(snipMask)<140
            snipMask = stim_idx(k)+50:stim_idx(k)+50+139;
        end
        snips(k,:) = X(snipMask);
    end
    
    %convert to columns: 
    snips = snips';

    %calcualte power estimates
    powSampIDX = round((stim_idx(1:end-1) + stim_idx(2:end)) / 2); 
    curi = 1; 
    for f = 1:length(frex)
        sig = filtfilt(storedFilters(f).low, snips);
        sig = filtfilt(storedFilters(f).high, sig);
        curPow = mean(abs(hilbert(sig).^2), 1);
        %add linear interpolated power estimates across the time: 
        for k = 1:numel(stim_idx)-1
            powEst(ii, curi:powSampIDX(k), f) = linspace(powEst(ii,curi,f), ...
                curPow(k), powSampIDX(k)-curi+1); 
            curi = powSampIDX(k);
        end
        powEst(ii,curi:end,f) = linspace(powEst(ii,curi,f), 0, ...
                           size(powEst,2)-curi+1);
    end
     
    starti = [starti powSampIDX(1)]; 
    endi = [endi powSampIDX(end)];
    %use mask to pull neuromod and respiration in time aligned windows: 
     neuroModOut(ii,:,:) = outDat.data(neuromodChans, mask).'; 
     respOut(ii,:) = rspDat(mask); 

 end
%trim non valid points: 
starti = max(starti);
endi = min(endi);
powEst(:,endi:end,:) = []; 
powEst(:,1:starti,:) = []; 
neuroModOut(:,endi:end,:) = []; 
neuroModOut(:,1:starti,:) = []; 
respOut(:,endi:end,:) = []; 
respOut(:,1:starti,:) = []; 

breathON = 1000 - starti; 

 dbPow = powEst; 
 for k = 1:size(powEst,1)
     for f = 1:length(frex)
        dbPow(k,:,f) = 10*log10(powEst(k,:,f) ./ mean(powEst(k,400:breathON,f), 2)); 
     end
 end

figure;
imagesc(squeeze(mean(dbPow,1))');
colorbar
caxis([-2,2])
set(gca,'ydir','normal')
yticks(2:2:20)
yticklabels(round(frex(2:2:20)))
xticks([breathON-500:250:breathON+1500])
xticklabels([-1:.5:3])
xlim([breathON-250 breathON+1500])



% --- time axis (assumes respOut/neuroModOut match powEst time bins) ---
ax = gca;
x = 1:size(squeeze(mean(powEst,1))',2);   % columns of the imagesc matrix = time

% --- put BOTH traces on the RIGHT axis, and rescale neuroMod to resp range ---
yyaxis right

r = mean(respOut,1);
n = squeeze(mean(neuroModOut(:,:,1),1));   % average over trials/obs (dim 1), keep time

% ensure row vectors
r = r(:).';
n = n(:).';

% robust scaling: map neuroMod to resp's dynamic range using percentiles
r_lo = prctile(r,5);   r_hi = prctile(r,95);
n_lo = prctile(n,5);   n_hi = prctile(n,95);

n_scaled = (n - n_lo) ./ (n_hi - n_lo + eps);   % 0..1
n_scaled = n_scaled .* (r_hi - r_lo) + r_lo;    % -> resp range

plot(x, r, 'k', 'LineWidth', 2); hold on
plot(x, n_scaled, 'm', 'LineWidth', 3);

% make the right axis match the resp scale nicely
ylim([r_lo r_hi])
ylabel('Resp (black) + NeuroMod (magenta, rescaled)')

% optional: legend + keep image visible behind
legend({'Resp','NeuroMod (rescaled)'}, 'Location','northwest')
ax.YAxis(2).Color = 'k';   % right-axis color













% --- build a single NaN mask and apply to all 3 channels ---
nan_mask = false(N,1);
for k = 1:numel(stim_idx)
    c  = stim_idx(k);
    lo = max(1, c - pad);
    hi = min(N, c + pad);
    nan_mask(lo:hi) = true;
end

X_clean = X;                    % 3 x T
X_clean(:, nan_mask) = NaN;

% --- plot: all 3 channels with vertical offsets, plus grey originals ---
off = 20;
offsets = (0:numel(chans)-1) * off;

fig = figure('Color','w', 'visible', false); hold on

% --- left axis: ephys (offset) ---
yyaxis left
for iC = 1:numel(chans)
    y_raw   = X(iC,:)       + offsets(iC);
    y_clean = X_clean(iC,:) + offsets(iC);

    plot(y_raw,  '--', 'Color', [0.85 0.85 0.85], 'LineWidth', 1); % lighter grey original
    plot(y_clean, 'k-',  'LineWidth', 1);                          % black cleaned
end

xlim([0 1500])
ylim([-20 70])

% X axis labels in ms relative to inhale
xticks(0:200:1600)
xticklabels(-1000:400:2200)
xlabel('Time Relative to Inhale (ms)')

ylabel('Voltage (\muV)')

% Remove y tick labels (keep ticks off entirely)
yticks([])
