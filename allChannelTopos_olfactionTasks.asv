test2= allPACgamPeakidx50(idx); 
test = cat(1, test{:}); 
test2= cat(1, test2{:}); 
[dupidx1, order] = sort(test2); 
test = (test - mean(test, 2)) ./ std(test, [], 2); 
imagesc(test(order, :))
clim([-.5 5])

